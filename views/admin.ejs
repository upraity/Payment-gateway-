<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Payment review | SabkaCode</title><link rel="stylesheet" href="/style.css"></head><body><header class="top"><a class="brand" href="/">SabkaCode Admin</a><form method="post" action="/admin/logout"><button class="btn secondary">Logout</button></form></header><main class="container"><h1>Payment submissions</h1><p class="muted">Check the UTR against your actual bank/UPI statement before approving.</p><div class="table-wrap"><table><thead><tr><th>Order / date</th><th>Customer</th><th>Resource / amount</th><th>Payment proof</th><th>Status / action</th></tr></thead><tbody>
<% payments.forEach(p => { %><tr><td><strong><%= p.reference %></strong><br><small><%= p.created_at %></small></td><td><%= p.customer_name %><br><%= p.email %><br><%= p.phone || "—" %></td><td><%= p.product_name %><br><strong>₹<%= money(p.amount_paise) %></strong></td><td>UTR: <strong><%= p.transaction_id %></strong><br><a target="_blank" rel="noopener" href="/admin/screenshot/<%= p.id %>">View screenshot</a></td><td><span class="status <%= p.status %>"><%= p.status %></span><% if (p.status === "pending") { %><form class="review" method="post" action="/admin/payment/<%= p.id %>/status"><input name="adminNote" placeholder="Optional note"><button class="btn small-btn" name="status" value="verified">Verify</button><button class="btn danger small-btn" name="status" value="rejected">Reject</button></form><% } else { %><p class="small"><%= p.admin_note %></p><% } %></td></tr><% }) %>
<% if (!payments.length) { %><tr><td colspan="5">No submissions yet.</td></tr><% } %></tbody></table></div></main></body></html>